{
  "name": "Google Store",
  "dataColors": [
    "#4285F4",
    "#EA4335",
    "#FBBC04",
    "#34A853",
    "#A8C7FA",
    "#F6AEA9",
    "#FDE293",
    "#A8DAB5",
    "#5F6368"
  ],
  "background": "#FFFFFF",
  "foreground": "#202124",
  "tableAccent": "#4285F4",
  "good": "#34A853",
  "neutral": "#FBBC04",
  "bad": "#EA4335",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#202124" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#202124" },
    "label": { "fontFace": "Segoe UI", "fontSize": 9, "color": "#5F6368" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 24, "color": "#202124" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F1F3F4" } }, "transparency": 0 }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#DADCE0" } }, "radius": 4 }]
      }
    }
  }
}